      "compatibleBases": [
        "csr-v0.14.1"
      ],
      "layout": "global",
      "discs": {
        "1": "./single-disc-csr-manip-movies-v0.1.4/layers/disc1.layer.json"
      },
      "enabled": true,
      "hidden": true,
      "uiHidden": true,
      "autoIncludeWhen": {
        "addonSelectedPrefix": "single-disc-on-csr-v",
        "bases": [
          "csr-v0.14.1"
        ],
        "unlessAddonIdPrefix": "csr-plus-scene-"
      }
    },
