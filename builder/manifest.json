      "betaNote": "Single-disc is still playtesting; known freezes and glitches on some paths.",
      "version": "0.1.0"
    },
    {
      "id": "single-disc-csr-manip-movies-v0.1.4",
      "name": "CSR manip movies",
      "kind": "mod",
      "version": "0.1.4",
      "blurb": "D2/D3 manip FMVs on D1. v0.1.4 restores LBA 250450 CANONON Form2 alias for LOSLAKE1 waterfall seek (was rocket/RCKTFAIL). Keeps Form2 MOVIE_ID eng size/aux.",
      "hint": "Hidden. Auto with Single-disc on CSR when CSR+ off.",
      "format": "ic-layer-v1",
      "compatibleBases": [
        "csr"
      ],
      "layout": "global",
      "discs": {
        "1": "./single-disc-csr-manip-movies-v0.1.4/layers/disc1.layer.json"
      },
      "enabled": false,
      "hidden": true,
      "uiHidden": true,
      "autoIncludeWhen": {
