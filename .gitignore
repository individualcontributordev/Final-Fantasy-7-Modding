# Local disc / RE artifacts — never commit game data or large binaries

# workspace: ignore everything except .gitkeep placeholders
workspace/*
!workspace/**/
!workspace/**/.gitkeep

# Ghidra projects (local)
workspace/ghidra/*
!workspace/ghidra/.gitkeep

# Ghidra exports (raw game data - keep local only)
workspace/ghidra-exports/

# Ghidra analysis (structured output - committed)
!workspace/ghidra-analysis/
!workspace/ghidra-analysis/**

# Common disc / dump companions (anywhere under workspace)
workspace/**/*.bin
workspace/**/*.BIN
workspace/**/*.cue
workspace/**/*.CUE
workspace/**/*.img
workspace/**/*.iso
workspace/**/*.ISO
workspace/**/*.ccd
workspace/**/*.sub
workspace/**/*.toc
workspace/**/*.mds
workspace/**/*.mdf
workspace/**/*.nrg
workspace/**/*.chd
workspace/**/*.ecm
workspace/**/*.dec
workspace/**/*.dec.*
workspace/**/*.new
workspace/**/*.pristine
workspace/**/*.gz
workspace/**/*.gzip
workspace/**/FIELD.BIN
workspace/**/FIELD.BIN.*
workspace/**/*.makou
workspace/**/*.X

# Emulator / save junk if dropped in the repo
workspace/**/*.mcd
workspace/**/*.sav
workspace/**/*.srm
workspace/**/*.state
workspace/**/*.dst
**/duckstation*/
**/*.duckstation*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env

# Pages staging (CI only)
_site/

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
*.lnk
*.swp
*~
.idea/
.vscode/
*.code-workspace

# Browser captures — sanitize before archive
*.har
# history archives are intentional tracked artifacts
!docs/history/
!docs/history/**/
workspace/iso-extract/battle-dec/SCUS_941.63.body
workspace/iso-extract/battle-raw/SCUS_941.63
workspace/iso-extract/battle-raw/BATTLE_BATRES.X.s4zero
workspace/iso-extract/battle-raw/BATTLE_BATRES.X.s4zero_noanim4
workspace/iso-extract/battle-raw/BATTLE_BATRES.X.skipsetup_s4zero_noanim4
workspace/tmp/*
