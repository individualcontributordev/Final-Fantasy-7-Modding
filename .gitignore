workspace/iso-extract/*.img
workspace/iso-extract/*.iso
workspace/iso-extract/FIELD.BIN
workspace/iso-extract/FIELD.BIN.*
workspace/iso-extract/*.dec
workspace/iso-extract/*.dec.*

workspace/ghidra/*.gpr
workspace/ghidra/*.rep/
workspace/ghidra/*.lock

.DS_Store
