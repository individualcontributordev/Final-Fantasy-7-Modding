# Local disc / RE artifacts — never commit game data or large binaries

# workspace: ignore everything except folder READMEs
workspace/*
!workspace/**/
!workspace/**/README.md

# Ghidra projects (local)
workspace/ghidra/*
!workspace/ghidra/.gitkeep

# Patch outputs: keep docs + small hex stubs; ignore rebuilt game blobs
workspace/patches/**
!workspace/patches/**/
!workspace/patches/**/*.md
!workspace/patches/**/*.hex
!workspace/patches/README.md

# Common disc / dump companions (anywhere under workspace)
workspace/**/*.bin
workspace/**/*.BIN
workspace/**/*.cue
workspace/**/*.CUE
workspace/**/*.img
workspace/**/*.iso
workspace/**/*.ISO
workspace/**/*.ccd
workspace/**/*.sub
workspace/**/*.toc
workspace/**/*.mds
workspace/**/*.mdf
workspace/**/*.nrg
workspace/**/*.chd
workspace/**/*.ecm
workspace/**/*.dec
workspace/**/*.dec.*
workspace/**/*.new
workspace/**/*.pristine
workspace/**/*.gz
workspace/**/*.gzip
workspace/**/FIELD.BIN
workspace/**/FIELD.BIN.*
workspace/**/*.makou

# Emulator / save junk if dropped in the repo
workspace/**/*.mcd
workspace/**/*.sav
workspace/**/*.srm
workspace/**/*.state
workspace/**/*.dst
**/duckstation*/
**/*.duckstation*

# Generated research HTML (built in CI / scripts/build_site_docs.py)
site/research/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
*.lnk
*.swp
*~
.idea/
.vscode/
*.code-workspace
