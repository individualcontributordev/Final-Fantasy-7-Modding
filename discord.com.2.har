            "text": "[{\"type\":0,\"content\":\"Ok so I got the CSR running on the PS2 using Popstarter without patching it, but the battles don't work right, gameplay seems fine.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T23:26:12.561000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304225424598896732\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":617},{\"type\":0,\"content\":\"IC is way more motivated a person if he wants to do it. I'd finish like next year lol\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:54:25.693000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304217426614812773\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"191046608064872449\",\"username\":\"hopeproductions\",\"avatar\":\"ea6a8fcda648eb65fdae9becbd0c4fe4\",\"discriminator\":\"0\",\"public_flags\":512,\"flags\":512,\"banner\":null,\"accent_color\":null,\"global_name\":\"Hope\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":616},{\"type\":0,\"content\":\"I think Hope was looking into making that at one point\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:51:57.741000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"i