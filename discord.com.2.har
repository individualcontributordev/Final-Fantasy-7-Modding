            "text": "[{\"type\":0,\"content\":\"I wasn't anticipating the up left soon enough so didn't switch to just left in time, wouldn't surprise me honestly\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-01T18:02:27.688000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1290735599749431367\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":4},{\"type\":0,\"content\":\"Yeah I feel like you can do that in the original too but I'll check it out again tonight thank you!\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-01T17:37:04.978000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1290729213040787616\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":3},{\"type\":0,\"content\":\"Whoops\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-01T17:05:31.891000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1290721272858411060\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":2},{\"type\":0,\"content\":\"\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[{\"id\":\"1290721248887832596\",\"filename\":\"Whoopsie.mp4\",\"size\":6262450,\"url\":\"https://cdn.discordapp.com/attachments/1288235003901120586/1290721248887832596/Whoopsie.mp4?ex=6a6e2756&is=6a6cd5d6&hm=efa8564db05b9667e2264eee3a7ffa237685922ce422dfb4434f7cd5e9e07238&\",\"proxy_url\":\"https://media.discordapp.net/attachments/1288235003901120586/1290721248887832596/Whoopsie.mp4?ex=6a6e2756&is=6a6cd5d6&hm=efa8564db05b9667e2264eee3a7ffa237685922ce422dfb4434f7cd5e9e07238&\",\"width\":1920,\"height\":1080,\"content_type\":\"video/mp4\",\"placeholder\":\"h/cFFIL86ElujIhxqZP6k6p/+Q==\",\"placeholder_version\":1}],\"embeds\":[],\"timestamp\":\"2024-10-01T17:05:26.404000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1290721249844265053\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1},{\"type\":21,\"content\":\"\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-09-29T14:51:16.987000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1289962712410882048\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"message_reference\":{\"type\":0,\"channel_id\":\"944817091737964644\",\"message_id\":\"1288235003901120586\",\"guild_id\":\"936291902133796955\"},\"position\":0,\"referenced_message\":{\"type\":0,\"content\":\"I made a CSR for any% and 100% (including variants NMS, All Bosses, etc.). I've only made patches for disc 1 and 2, I didn't touch disc 3 because there was no point. I've tested these by burning them to a disc and running it in my PS2 Slim (MechaPwn'd to play NTSC and backups).  But they also work for Emulator/Digital. Curious to know if anyone would be interested in further testing these? and if you have any suggestions?  \\n\\nApply the patches to your FF7 NTSC/US PS1 .bin files.\\n\\n## Steps\\n\\n1. Go to https://www.romhacking.net/patch/\\n2. Select your original .bin file, ignore the \\\"file too big\\\" warning\\n3. Select the patch .ppf file\\n4. Click the \\\"Apply patch\\\" button\\n\\nYour browser should download a new patched version of the disc.\\n\\nYou can burn the patched version to disc or load it up in an emulator (I used duckstation version 0.1-7371-gb2577ef8b (dev) for testing). I used ImgBurn with write speed 16x on Verbatim CD-R 700MB discs.\\n\\n## Details\\n\\nThese patches remove most if not all FMVs, shortens some in-game cutscenes, and reduces some mashing sequences.\\n\\n**All \\\"skill checks\\\" are present in this CSR, if not let me know and I'll fix it.**\\n\\nLatest patch releases are on GitHub https://github.com/individualcontributordev/Final-Fantasy-7-CSR\\n\\nChange log https://github.com/individualcontributordev/Final-Fantasy-7-CSR/blob/main/CHANGELOG.md\\n\\nDiscussion on bugs and fixes in thread \\ud83e\\uddf5\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-09-24T20:25:59.179000+00:00\",\"edited_timestamp\":\"2024-10-26T23:22:36.031000+00:00\",\"flags\":36,\"components\":[],\"id\":\"1288235003901120586\",\"channel_id\":\"944817091737964644\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"thread\":{\"id\":\"1288235003901120586\",\"type\":11,\"last_message_id\":\"1308221962883043339\",\"flags\":0,\"guild_id\":\"936291902133796955\",\"name\":\"Final Fantasy 7 CSR Patches (IndividualContributor)\",\"parent_id\":\"944817091737964644\",\"rate_limit_per_user\":0,\"bitrate\":64000,\"user_limit\":0,\"rtc_region\":null,\"owner_id\":\"183261151746850816\",\"thread_metadata\":{\"archived\":true,\"archive_timestamp\":\"2024-12-19T00:11:24.513000+00:00\",\"auto_archive_duration\":4320,\"locked\":false,\"create_timestamp\":\"2024-09-29T14:51:16.973000+00:00\"},\"message_count\":1352,\"member_count\":9,\"total_message_sent\":1378,\"member_ids_preview\":[\"132969911239704576\",\"289891674660929538\",\"183261151746850816\",\"191046608064872449\",\"170713534726930432\"]}}}]\n"
