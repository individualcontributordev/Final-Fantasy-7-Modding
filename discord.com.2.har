_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":709},{\"type\":0,\"content\":\"<@248225699909861376> both saves are loading fine <:Sadge:1074826312767778950> on the PS2 Popstarter emulator\",\"mentions\":[{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T16:59:21.509000+00:00\",\"edited_timestamp\":\"2024-11-08T17:02:16.633000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304490458256506922\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":708},{\"type\":19,\"content\":\"Yeah it's the same with FF9, it may still be emulation but feels a lot better than a PC emulator. Not that I would notice or benefit from it at my level on that game but yeah\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T13:22:57.981000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304436001393086561\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"message_reference\":{\"type\":0,\"channel_id\":\"1288235003901120586\",\"message_id\":\"1304352572383166535\",\"guild_id\":\"936291902133796955\"},\"position\":707,\"referenced_message\":{\"type\":19,\"content\":\"I got everything working I'll write some notes and send them over. I'm using SMB so sharing a folder on my PC, dropping in the CSR, then loading from PS2. It's great because there is zero input lag playing it on PS2 and it's the CSR with no discs involved but the colors are a little weird on battles so nothing major.\\n\\nBut it's still emulated, I can't reproduce the D2 issue because it just works on this, similar to Duckstation.\",\"mentions\":[{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T07:51:26.955000+00:00\",\"edited_timestamp\":\"2024-11-08T07:55:18.588000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304352572383166535\",\"channel_id\":\"1288235003901120586\",\"author\":{\