            "text": "[{\"type\":0,\"content\":\"You can create the patch using https://www.romhacking.net/patch/\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[{\"type\":\"image\",\"url\":\"https://www.romhacking.net/patch/\",\"title\":\"Rom Patcher JS\",\"description\":\"An online web-based ROM patcher. Supported formats: IPS, BPS, UPS, APS, RUP, PPF and xdelta.\",\"content_scan_version\":4}],\"timestamp\":\"2024-11-09T15:23:46.941000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304828793600344096\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":921},{\"type\":0,\"content\":\"Might help narrow it down\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T15:21:32.874000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304828231282856068\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":920},{\"type\":0,\"content\":\"I'm uploading the bin to Google Drive rn, I can't remember the ppf but know that I set it up on the 1st of October\",\"mentions\":[],