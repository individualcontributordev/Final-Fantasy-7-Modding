},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":613},{\"type\":0,\"content\":\"so after you leave Mt. Nibel for example, you'd load into Gongaga. Then leaving Gongaga load into Temple\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:38:56.818000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304213530630946877\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":612},{\"type\":0,\"content\":\"we have one for FF8\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:38:23.608000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304213391338115072\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":611},{\"type\":19,\"content\":\"No sorry, I meant something where all the 'Live Step' screens play back to back kind of\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:38:17.504000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304213365735952446\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"message_reference\":{\"type\":0,\"channel_id\":\"1288235003901120586\",\"message_id\":\"1304176433353986079\",\"guild_id\":\"936291902133796955\"},\"position\":610,\"referenced_message\":{\"type\":0,\"content\":\"Could you make a step count% for me lol\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T20:11:32.138000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304176433353986079\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":587}},{\"type\":0,\"content\":\"But yeah, whole different game entirely\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:20:43.813000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304208946235707526\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":609},{\"type\":0,\"content\":\"You can't just drop down to the bottom floor by holding down left on a backup disc or even an original like you can here on both Integral/US releases\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:20:36.907000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304208917269712956\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":608},{\"type\":0,\"content\":\"https://youtu.be/SF8KirKi3FU?si=xGWNaWS3zKWg-3Ln&t=1250\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[{\"type\":\"video\",\"url\":\"https://www.youtube.com/watch?v=SF8KirKi3FU&start=1250\",\"title\":\"OpenPS2Loader meme run\",\"description\":\"Go to 20:20 and 20:55 for weird shenanigans\",\"color\":16711680,\"author\":{\"name\":\"\\u014ckamikaze\",\"url\":\"https://www.youtube.com/channel/UC5akRG8UWJHMEW_e86Th0bg\"},\"provider\":{\"name\":\"YouTube\",\"url\":\"https://www.youtube.com\"},\"thumbnail\":{\"url\":\"https://i.ytimg.com/vi/SF8KirKi3FU/maxresdefault.jpg\",\"proxy_url\":\"https://images-ext-1.discordapp.net/external/D9Pk5iqKJnLawcW9ao-Z3eIqSeHz0tBjaYMp1DgDtYQ/https/i.ytimg.com/vi/SF8KirKi3FU/maxresdefault.jpg\",\"width\":1280,\"height\":720,\"content_type\":\"image/jpeg\",\"placeholder\":\"CdgJBIRld4p6lnegqYUFa9RL+Q==\",\"placeholder_version\":1,\"flags\":0},\"video\":{\"url\":\"https://www.youtube.com/embed/SF8KirKi3FU?start=1250\",\"width\":1280,\"height\":720,\"placeholder\":\"CdgJBIRld4p6lnegqYUFa9RL+Q==\",\"placeholder_version\":1,\"flags\":0},\"content_scan_version\":2}],\"timestamp\":\"2024-11-07T22:19:21.936000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304208602818678804\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":607},{\"type\":0,\"content\":\"If I had to digress even further about OPL being different to backup discs, this is probably the biggest example\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:19:20.822000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304208598146089051\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":606},{\"type\":0,\"content\":\"As for games overall, I can tell you that an FF9 CSR Disc 4 burned disc doesn't have slowdown or slow loads to the degree that playing it on POP has\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:16:47.007000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304207952999092284\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":605},{\"type\":0,\"content\":\"Ain't no way dude, POPStarter ff7 doesn't even let you get to the presents splash. You need to patch it with something that was made the start of this year to get it to work\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:16:05.728000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304207779862544425\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":604,\"reactions\":[{\"emoji\":{\"id\":\"1074826312767778950\",\"name\":\"Sadge\"},\"count\":1,\"count_details\":{\"burst\":0,\"normal\":1},\"burst_colors\":[],\"me_burst\":false,\"burst_me\":false,\"me\":true,\"burst_count\":0}]},{\"type\":0,\"content\":\"\\ud83e\\udd1e\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:13:24.011000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304207101572288545\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":603},{\"type\":0,\"content\":\"Which is what I'll be using over the network too, so if I can get this working it seems like the CSR will be running in the same environment, either over network or burned disc.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:13:19.533000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304207082790322289\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":602},{\"type\":0,\"content\":\"ChatGPT FTW\\n\\nPOPS (PopStation Emulator)\\nPOPS stands for PlayStation Operating System, and it's the name of the software emulator that the PS2 uses when running PS1 games from other sources, like burned discs, or digital versions of PS1 games stored on a memory card or external storage.\\n\\nSo this tells me that the burned CSR discs are running on Pops?\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:12:11.710000+00:00\",\"edited_timestamp\":\"2024-11-07T22:12:37.216000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304206798319779962\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":601},{\"type\":0,\"content\":\"i.e. if I put in my normal FF7 disc its loaded into Pop\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:07:44.726000+00:00\",\"edited_timestamp\":\"2024-11-07T22:07:51.340000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304205678507982858\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":600},{\"type\":0,\"content\":\"I'm starting to suspect that backward compatibility on the PS2 Slim uses Pop emulator normally\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:07:24.851000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304205595146059827\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":599},{\"type\":0,\"content\":\"So does FF7 play on the POP emulator regardless of disc, network, or USB?\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:06:54.810000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304205469144846376\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":598}]\n"
