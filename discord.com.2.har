            "text": "[{\"type\":0,\"content\":\"Fun fact about bodcap, who made the FF9 HD CSR. Similar situation, made it to run it. When he was finished he was so fed up with FF9 he never ran it \\ud83d\\ude05\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-12T19:43:35.068000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1305981338540707910\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1144},{\"type\":19,\"content\":\"I've seen the end of your run so it seemed that it went thru whatever version you used ! 5:17 right ?\",\"mentions\":[{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-12T19:43:34.749000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1305981337202593893\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"309356817169776641\",\"username\":\".rendall\",\"avatar\":\"92721b514158fd7d7a9ea5e1768da748\",\"discriminator\":\"0\",\"public_flags\":512,\"flags\":512,\"banner\":null,\"accent_color\":null,\"global_name\":\"Rendall\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\"