\":{\"id\":\"158301632776503296\",\"username\":\"dashretro\",\"avatar\":\"7bc6752f3b6eaba17fd06b7543706b53\",\"discriminator\":\"0\",\"public_flags\":512,\"flags\":512,\"banner\":null,\"accent_color\":null,\"global_name\":\"Dash Retro\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":167},{\"type\":0,\"content\":\"But \\\"too fast\\\" should still work because the trick lands you at the end of the window usually\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-28T22:19:14.063000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1300584691140919326\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"158301632776503296\",\"username\":\"dashretro\",\"avatar\":\"7bc6752f3b6eaba17fd06b7543706b53\",\"discriminator\":\"0\",\"public_flags\":512,\"flags\":512,\"banner\":null,\"accent_color\":null,\"global_name\":\"Dash Retro\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":166},{\"type\":0,\"content\":\"Duckstation probably has the opposite problem of loading too fast, yeah\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-28T22:18:46.441000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1300584575285727365\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"158301632776503296\",\"username\":\"dashretro\",\"avatar\":\"7bc6752f3b6eaba17fd06b7543706b53\",\"discriminator\":\"0\",\"public_flags\":512,\"flags\":512,\"banner\":null,\"accent_color\":null,\"global_name\":\"Dash Retro\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\"