            "text": "[{\"type\":0,\"content\":\"I've just tested patching an original .bin and starting a new game and it's working for me, I'm interested to know more about this issue if you have more details.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-21T09:55:08.919000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297860720775397417\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":69},{\"type\":19,\"content\":\"As for the FMV glitch Idk. I'll check a save state soon to see\",\"mentions\":[{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-21T08:56:02.230000+00:00\",\"edited_timestamp\":\"2024-10-21T14:54:26.137000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1297845844883804190\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"message_reference\":{\"type\":0,\"channel_id\":\"1288235003901120586\",\"message_id\":\"1297692119670198303\",\"guild_id\":\"936291902133796955\"},\"position\":68,\"referenced_message\":{\"type\":19,\"content\":\"Using this save state I can get the Cloud giving Seph the black materia video lol. <@248225699909861376> did you say it's not happening with the latest patch?\",\"mentions\":[{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T22:45:11.283000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297692119670198303\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"message_reference\":{\"type\":0,\"channel_id\":\"1288235003901120586\",\"message_id\":\"1297569246036885515\",\"guild_id\":\"936291902133796955\"},\"position\":65}},{\"type\":0,\"content\":\"I loaded the patched iso manually and booted the game from there\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-21T08:54:59.279000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297845580848173076\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":67},{\"type\":0,\"content\":\"From making CSRs I know the loading ran issues\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-21T08:54:31.022000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297845462329458719\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":66},{\"type\":19,\"content\":\"Using this save state I can get the Cloud giving Seph the black materia video lol. <@248225699909861376> did you say it's not happening with the latest patch?\",\"mentions\":[{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T22:45:11.283000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297692119670198303\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"message_reference\":{\"type\":0,\"channel_id\":\"1288235003901120586\",\"message_id\":\"1297569246036885515\",\"guild_id\":\"936291902133796955\"},\"position\":65,\"referenced_message\":{\"type\":0,\"content\":\"here's the save state for Duck for that issue. i tried it again and it's still the same. However, that wasn't noticed on redoing the saves so i'd assume it's already been fixed (but you can still see it on a newer version of the CSR using this save)\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[{\"id\":\"1297569245458202634\",\"filename\":\"47_Enter_Junon_MENU.sav\",\"size\":1863753,\"url\":\"https://cdn.discordapp.com/attachments/1288235003901120586/1297569245458202634/47_Enter_Junon_MENU.sav?ex=6a6e0487&is=6a6cb307&hm=7bf7cad8919a8701d6334e7bbe8672ab06d9dc9a8c7813866f6320f23d4355f7&\",\"proxy_url\":\"https://media.discordapp.net/attachments/1288235003901120586/1297569245458202634/47_Enter_Junon_MENU.sav?ex=6a6e0487&is=6a6cb307&hm=7bf7cad8919a8701d6334e7bbe8672ab06d9dc9a8c7813866f6320f23d4355f7&\",\"content_scan_version\":0,\"title\":\"47 Enter Junon MENU\"}],\"embeds\":[],\"timestamp\":\"2024-10-20T14:36:55.926000+00:00\",\"edited_timestamp\":\"2024-10-20T14:37:35.575000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1297569246036885515\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":52}},{\"type\":0,\"content\":\"Oh and for testing while doing a run try to use a single run, i.e. only use save states created during the run and not from other runs. This way you'll be able to verify that RAM values are set correctly as you progress through the run based on the patch edits.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T19:20:15.303000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297640546591834235\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":64},{\"type\":0,\"content\":\"I'll push the new patch now and continue testing.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T19:19:06.369000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297640257461682267\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":63},{\"type\":0,\"content\":\"I'll push the latest patch that I'm working on now, starting a new game is fine for me I'm doing a run of Disc 1 now, and will checkout the Aps stuff too. I'm wondering if save states are causing the issues because your essentially saving RAM values which will remain broken if you saved on a previous patch and then load the saved state with a new patch, some issues will still be there because variables were not set correctly. I've also seen some issues using save states where I load one and then swap to the patched disc and I get double boss fights and stuff like that. I would say if you're using save states try to make a save at least 2 fields from a CSR edit, for example in temple make a save on the world map and then maybe another on the weird maze screen so that you can test entering template and the rolling rocks screen.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T19:18:46.772000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297640175266169025\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":62},{\"type\":0,\"content\":\"Yw. It's even giving me black screens after loading save states I would normally swap in csr for\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T18:54:30.293000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297634066350342148\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":61},{\"type\":0,\"content\":\"Thanks for checking, not just me then.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T18:41:45.044000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297630856663531601\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":60},{\"type\":0,\"content\":\"Yeah I'm having the same issue\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T18:30:15.096000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297627962811744380\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":59},{\"type\":0,\"content\":\"it could be something else, but to just get some practice in I loaded a state at the start of the game then manually changed disc to the new CSR. All worked as intended up until the APs exp screen. Once the fight had finished and I accepted the rewards etc, it froze at a black screen with the fanfare music still playing. Just said I'd mention it, but it might be a false error.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T16:30:18.090000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297597776380825752\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":58},{\"type\":0,\"content\":\"if anyone else has a moment to test\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T15:12:31.132000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297578201740083243\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":57},{\"type\":0,\"content\":\"I repatched just to test and it still doesn't work. Once you hit New Game its just black screen\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T15:12:25.942000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297578179971776522\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":56},{\"type\":0,\"content\":\"just stays on black screen\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T15:06:54.607000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297576790251798580\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":55},{\"type\":0,\"content\":\"Just checked the newest version and I can't get passed the start of the game\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T15:06:45.791000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297576753274814475\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":54},{\"type\":0,\"content\":\"but, for testing it's there if you wish to see it\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T14:37:05.695000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297569287011045397\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":53},{\"type\":0,\"content\":\"here's the save state for Duck for that issue. i tried it again and it's still the same. However, that wasn't noticed on redoing the saves so i'd assume it's already been fixed (but you can still see it on a newer version of the CSR using this save)\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[{\"id\":\"1297569245458202634\",\"filename\":\"47_Enter_Junon_MENU.sav\",\"size\":1863753,\"url\":\"https://cdn.discordapp.com/attachments/1288235003901120586/1297569245458202634/47_Enter_Junon_MENU.sav?ex=6a6e0487&is=6a6cb307&hm=7bf7cad8919a8701d6334e7bbe8672ab06d9dc9a8c7813866f6320f23d4355f7&\",\"proxy_url\":\"https://media.discordapp.net/attachments/1288235003901120586/1297569245458202634/47_Enter_Junon_MENU.sav?ex=6a6e0487&is=6a6cb307&hm=7bf7cad8919a8701d6334e7bbe8672ab06d9dc9a8c7813866f6320f23d4355f7&\",\"content_scan_version\":0,\"title\":\"47 Enter Junon MENU\"}],\"embeds\":[],\"timestamp\":\"2024-10-20T14:36:55.926000+00:00\",\"edited_timestamp\":\"2024-10-20T14:37:35.575000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1297569246036885515\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":52},{\"type\":4,\"content\":\"Final Fantasy 7 CSR Patches (IndividualContributor)\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T09:33:44.596000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297492946068836433\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":51},{\"type\":19,\"content\":\"Do you happen to have a DS save state for this? I think I know why you saw it, there is code to \\\"save the next frame of a movie\\\" before a movie is played, so it essentially fast forwards the movies to the next one each time one is played. So I may have skipped this fast forwarding to an elevator clip so when you hit the elevator the little clip of the elevator moving is not read from the right place on disc. It just happened to me before the gas chamber stuff on disc 2.\\n\\nAnd just to clarify, you're using the elevator for \\\"Return to Junon\\\"? which is after \\\"Cloud's Dreams\\\"? on Disc 2?\\n\\nUPDATE: I've just been trying to reproduce the issue and I can't get it to play the Cloud giving Seph the black materia video, but I can play the Golden Saucer videos if I switch to Disc 1 before going in the elevator before Carry Armor. The code also correctly sets the video stuff before hitting the button so with the right disc in it plays as normal on my save state. I'm wondering if some variable during the \\\"Cloud's dream\\\" scenes was skipped causing an issue in the elevator but I've tested from gas chamber up to the elevator before Carry Armor now and can't reproduce. So it's likely something before the gas chamber section messing with the elevator later on.\",\"mentions\":[{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-19T21:14:08.006000+00:00\",\"edited_timestamp\":\"2024-10-19T23:31:35.836000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1297306817160020029\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"message_reference\":{\"type\":0,\"channel_id\":\"1288235003901120586\",\"message_id\":\"1296079583971377212\",\"guild_id\":\"936291902133796955\"},\"position\":50,\"referenced_message\":{\"type\":0,\"content\":\"The only other jarring thing I noticed was the Cargo Elevator in Junon. I guess the FMV for it moving up and down has been removed but I didn't know that so when I interacted with the button again it played a section of cloud giving Sephiroth the black materia in the Norther Crater. Jump scared the hell out me \\ud83d\\ude05\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-16T11:57:32.813000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1296079583971377212\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":31}}]\n"
