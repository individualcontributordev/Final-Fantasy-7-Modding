-10-30T00:45:06.687000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1300983790172377089\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":204},{\"type\":0,\"content\":\"Astounding Job!\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-30T00:43:20.371000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1300983344250490957\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":203},{\"type\":0,\"content\":\"Ok so I've added a text box with 3 choices, first is for Turbo, second will just set the timer to zero and continue the run, the third let's you pick between the 3 songs available in this field. Unfortunately I don't think it's possible to play any song, I've tried a few things and Googled a bunch of stuff but no luck. Having 3 songs is better then none so I'll leave it in, and someone might know how to get random songs playing from here later. https://youtu.be/-EjQHtFeSxA\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[{\"type\":\"video\",\"url\":\"https://www.youtub