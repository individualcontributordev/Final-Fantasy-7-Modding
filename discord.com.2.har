"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":442},{\"type\":0,\"content\":\"I'll be real, I dont think oceanfly(or whatever its called now) really warrants a break on csr\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-06T17:19:50.148000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1303770835810652322\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"289891674660929538\",\"username\":\"teeejj0102\",\"avatar\":\"aabd4c1026f28787683c2de660f2aa57\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Teeejj\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":{\"font_id\":8,\"effect_id\":1,\"colors\":[]},\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":441},{\"type\":0,\"content\":\"ok so, I've verified that changes in CoTA as of v0.4.7 have caused the issue, this includes the break scene. So somewhere between Bone Village and D2 swap on the patch is borking something. So I'll try to add the break scene to a D1 normal and then play through to D2 swap. This should tell me if the break scene specifically is causing the issue.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-06T17:18:59.853000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1303770624858128384\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":440},{\"type\":0,\"content\":\"I just need to incrementally test back further and further until I find the section that introduces the error in the console. Shouldn't take long....\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-06T17:02:27.830000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1303766464012226592\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":439},{\"type\":0,\"content\":\"if not then it's somewhere in temple or before that I've borked up and I'll test that too\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-06T17:01:46.036000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1303766288715485275\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":438},{\"type\":0,\"content\":\"I'm going to test using normal D1 through Red Dragon and DG up to Bone Village / CoTA, then swap in D1 patched. This should tell me if the issue is introduced in the Bone Village / CoTA updates I've made\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-06T17:00:52.553000+00:00\",\"edited_timestamp\":\"2024-11-06T17:01:26.229000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1303766064391520368\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":437}]\n"
