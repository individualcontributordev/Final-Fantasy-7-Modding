d\":\"191046608064872449\",\"username\":\"hopeproductions\",\"avatar\":\"ea6a8fcda648eb65fdae9becbd0c4fe4\",\"discriminator\":\"0\",\"public_flags\":512,\"flags\":512,\"banner\":null,\"accent_color\":null,\"global_name\":\"Hope\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1177},{\"type\":0,\"content\":\"Yeah\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-13T23:56:27.358000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1306407363602939995\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"191046608064872449\",\"username\":\"hopeproductions\",\"avatar\":\"ea6a8fcda648eb65fdae9becbd0c4fe4\",\"discriminator\":\"0\",\"public_flags\":512,\"flags\":512,\"banner\":null,\"accent_color\":null,\"global_name\":\"Hope\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1176},{\"type\":0,\"content\":\"No technical reason that I can think of, but there is some mashing to be done there before the fight. \\n\\nDo you mean as you transition into that scene the fight starts immediately?\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-13T23:56:02.231000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1306407258212532242\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1175},{\"type\":0,\"content\":\"Is there a reason you dont just go straight into the fight on bottomswell screen?\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-13T23:49:52.045000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1306405705539915778\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"191046608064872449\",\"username\":\"hopeproductions\",\"avatar\":\"ea6a8fcda648eb65fdae9becbd0c4fe4\",\"discriminator\":\"0\",\"public_flags\":512,\"flags\":512,\"banner\":null,\"accent_color\":null,\"global_name\":\"Hope\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1174,\"reactions\":[{\"emoji\":{\"id\":null,\"name\":\"\\u261d\\ufe0f\"},\"count\":1,\"count_details\":{\"burst\":0,\"normal\":1},\"burst_colors\":[],\"me_burst\":false,\"burst_me\":false,\"me\":false,\"burst_count\":0}]},{\"type\":0,\"content\":\"\\ud83c\\udfae Release v0.5.0 https://github.com/individualcontributordev/Final-Fantasy-7-CSR\\n\\n- Added back in the scene after Demons Gate where Cloud gives the Black Materia to Sephiroth\\n- Added 1 text box before Barret leaves hut in Gongaga where Cloud is lying down\\n- Jump down the hole to Battle Square and land in Prison after naming Cait Sith\\n- 1.5 seconds added back in before Ester enters the bottom of the scene before the Chocobo race\\n- Added back in 1 text box before Bottomswell fight\\n- Trimmed bottom of tower\\n- Added back in 1 text box on Broken Road\\n- Added 4 text boxes back in after Jenova fight on the boat when arm disappears\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[{\"type\":\"article\",\"url\":\"https://github.com/individualcontributordev/Final-Fantasy-7-CSR\",\"title\":\"GitHub - individualcontributordev/Final-Fantasy-7-CSR: Final Fantas...\",\"description\":\"Final Fantasy 7 CutScenes Removed. Contribute to individualcontributordev/Final-Fantasy-7-CSR development by creating an account on GitHub.\",\"color\":1975079,\"provider\":{\"name\":\"GitHub\"},\"thumbnail\":{\"url\":\"https://opengraph.githubassets.com/48c47181f6f1c0adf98cbab878d159e7c1b9be81e45a8cdc4f080ba3e5217585/individualcontributordev/Final-Fantasy-7-CSR\",\"proxy_url\":\"https://images-ext-1.discordapp.net/external/l8RYrztb896Avd0fHQku53qHqMC5PnD_qFJi2ggnMLU/https/opengraph.githubassets.com/48c47181f6f1c0adf98cbab878d159e7c1b9be81e45a8cdc4f080ba3e5217585/individualcontributordev/Final-Fantasy-7-CSR\",\"width\":1200,\"height\":600,\"content_type\":\"image/png\",\"placeholder\":\"/fcFBIBri8WTl2hceV+zHT/L8Q==\",\"placeholder_version\":1,\"flags\":0},\"content_scan_version\":4}],\"timestamp\":\"2024-11-13T23:40:35.622000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1306403371732963400\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1173},{\"type\":0,\"content\":\"Battle Square to Prison, Cloud jumped down the wrong pipe https://youtu.be/408A4IIqWpA?t=46\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[{\"type\":\"video\",\"url\":\"https://www.youtube.com/watch?v=408A4IIqWpA&start=46\",\"title\":\"FF7 CSR Battle square to Prison\",\"color\":16711680,\"author\":{\"name\":\"IndividualContributor\",\"url\":\"https://www.y