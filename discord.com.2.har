d\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":775},{\"type\":0,\"content\":\"is it actually possible to just put the entire CSR on one disc?\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:32:27.215000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304604483371663430\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":774},{\"type\":0,\"content\":\"I actually had pondered this earlier but I don't know enough\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:32:17.311000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304604441831280751\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":773},{\"type\":0,\"content\":\"leaving in D1 CSR and skipping over the disc swaps will bork the elevator FMVs and stuff like that iirc, but might not if we actually put D2 CSR in\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:32:04.248000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304604387041083455\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":772},{\"type\":0,\"content\":\"all game code is on all discs\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:31:27.203000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304604231663222846\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":771},{\"type\":0,\"content\":\"I think the only reason for the disc swaps are the FMVs\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:31:21.178000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304604206392410174\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":770},{\"type\":0,\"content\":\"I wonder would skipping the disc swap work, and just putting the break scene in instead, during the break you swap in D2 CSR and see what happens\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:30:56.992000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304604104949104650\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":769},{\"type\":0,\"content\":\"It's worth a test, but I think it won't work because it's the RAM that F'd not the disc, and putting in a regular D1 at the break means you get all the text boxes of the spiral scene then into disc swap but the RAM values are still borked. That's be my guess\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:29:28.008000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304603731723026533\",\"channel_id\":\"1288235003901120586\"