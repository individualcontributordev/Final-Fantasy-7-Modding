            "text": "[{\"type\":0,\"content\":\"just start the fight\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-13T23:58:33.040000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1306407890751459429\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1184},{\"type\":0,\"content\":\"It's your choice but to me it feels like leaving a cutscene in to have a screen where the only input is mashing\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-13T23:58:32.336000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1306407887798669386\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"191046608064872449\",\"username\":\"hopeproductions\",\"avatar\":\"ea6a8fcda648eb65fdae9becbd0c4fe4\",\"discriminator\":\"0\",\"public_flags\":512,\"flags\":512,\"banner\":null,\"accent_color\":null,\"global_name\":\"Hope\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1183},{\"type\":0,\"content\":\"you could genuinely skip the field text before them imo\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-13T23:58:29.543000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1306407876083974256\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909