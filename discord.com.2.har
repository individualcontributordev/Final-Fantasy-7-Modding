            "mimeType": "application/json",
            "text": "[{\"type\":0,\"content\":\"I'll reproduce with disc, then remove the break scene and test to verify it's the break scene. Then I'll try moving it and changing the music and stuff\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-04T20:54:02.434000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1303099966473900105\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":334},{\"type\":0,\"content\":\"I think I've like 25ish so hopefully that's enough to debug lol\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-04T20:52:31.575000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1303099585383764030\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":333},{\"type\":0,\"content\":\"I've about 10 left \\ud83d\\ude05\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-04T20:52:03.829000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":