            "text": "[{\"type\":0,\"content\":\"This is the best I can do on short notice. That's the whole memory card file and slot 3 is before Jenova\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T11:49:40.251000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304412522811752540\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":699},{\"type\":0,\"content\":\"\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[{\"id\":\"1304412443941933106\",\"filename\":\"MemoryCard3-5.mcd\",\"size\":131072,\"url\":\"https://cdn.discordapp.com/attachments/1288235003901120586/1304412443941933106/MemoryCard3-5.mcd?ex=6a6e8601&is=6a6d3481&hm=107c358161db3a76812b9e92b0149fb03927e95e2e314cade2ffd61c54780302&\",\"proxy_url\":\"https://media.discordapp.net/attachments/1288235003901120586/1304412443941933106/MemoryCard3-5.mcd?ex=6a6e8601&is=6a6d3481&hm=107c358161db3a76812b9e92b0149fb03927e95e2e314cade2ffd61c54780302&\",\"content_type\":\"application/vnd.mcd\",\"content_scan_version\":2}],\"embeds\":[],\"timestamp\":\"2024-11-08T11:49:21.519000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304412444244054077\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":698},{\"type\":0,\"content\":\"yeah I can try work something out\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T11:44:11.137000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304411142407589958\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":697},{\"type\":0,\"content\":\"\\ud83d\\udca1I might be able to get a save state over to my PS2 using this setup, <@248225699909861376> any chance you can get that save your using off your memcard and over to me?\",\"mentions\":[{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T07:53:50.120000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304353172860698684\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":696},{\"type\":19,\"content\":\"I got everything working I'll write some notes and send them over. I'm using SMB so sharing a folder on my PC, dropping in the CSR, then loading from PS2. It's great because there is zero input lag playing it on PS2 and it's the CSR with no discs involved but the colors are a little weird on battles so nothing major.\\n\\nBut it's still emulated, I can't reproduce the D2 issue because it just works on this, similar to Duckstation.\",\"mentions\":[{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T07:51:26.955000+00:00\",\"edited_timestamp\":\"2024-11-08T07:55:18.588000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304352572383166535\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"message_reference\":{\"type\":0,\"channel_id\":\"1288235003901120586\",\"message_id\":\"1304186244699521174\",\"guild_id\":\"936291902133796955\"},\"position\":695,\"referenced_message\":{\"type\":19,\"content\":\"Please help me set it up if you figure out how to patch FF7 to work on OPL. Or if you're using DKWDRV let me know if it's good and worth using \\ud83d\\udc4d\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T20:50:31.345000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304186244699521174\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"message_reference\":{\"type\":0,\"channel_id\":\"1288235003901120586\",\"message_id\":\"1304174317235474433\",\"guild_id\":\"936291902133796955\"},\"position\":591}},{\"type\":0,\"content\":\"makes sense\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T02:54:51.180000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304277931492642908\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":694},{\"type\":0,\"content\":\"Yeah I can try that tomorrow\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T02:54:43.409000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304277898898968597\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":693},{\"type\":0,\"content\":\"Another test: just use a normal D1, load in, fight Jenova and try go through to disc swap. No CSR this time at all. That would test the save itself\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T02:54:21.555000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304277807236517888\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":692},{\"type\":0,\"content\":\"The fact it's not working from loading a save and there is no break scene means either the save is holding onto some broken RAM stuff or it's breaking between the load and the swap. But there is very little changes now without the break\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T02:50:36.103000+00:00\",\"edited_timestamp\":\"2024-11-08T02:51:18.353000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304276861622419497\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":691},{\"type\":0,\"content\":\"I don't have a save on memcard yet to try this but will soon\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T02:48:16.241000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304276274998546492\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":690},{\"type\":0,\"content\":\"To see if something allows you to continue\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T02:47:57.889000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304276198024675359\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_s