            "text": "[{\"type\":0,\"content\":\"I'll remove the label\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T18:16:50.809000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304147570968494100\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":577},{\"type\":0,\"content\":\"<:KEKW:1074810897308069948>\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T18:16:41.310000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304147531126669343\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":576},{\"type\":0,\"content\":\"I don't normally grab that so I haven't experienced it personally\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T16:28:38.918000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304120342003843184\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":575},{\"type\":0,\"content\":\"Just thought I'd give the CSR a look and this happened? Is this known about?\\nI was grabbing a potion off the red dude and now I'm softlocked lol\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[{\"id\":\"1304110160201125938\",\"filename\":\"image.png\",\"size\":601293,\"url\":\"https://cdn.discordapp.com/attachments/1288235003901120586/1304110160201125938/image.png?ex=6a6e153b&is=6a6cc3bb&hm=88a7bfc494f3ff212fe30c86dd22177ea833c4dde5254223bd229b7e52074c7e&\",\"proxy_url\":\"https://media.discordapp.net/attachments/1288235003901120586/1304110160201125938/image.png?ex=6a6e153b&is=6a6cc3bb&hm=88a7bfc494f3ff212fe30c86dd22177ea833c4dde5254223bd229b7e52074c7e&\",\"width\":760,\"height\":591,\"content_type\":\"image/png\",\"placeholder\":\"jAgGDYKf/K3Mx5yGa3aGh6+r+Jd7\",\"placeholder_version\":1}],\"embeds\":[],\"timestamp\":\"2024-11-07T15:48:11.432000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304110160389603449\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"521419888959684659\",\"username\":\"themattdavis\",\"avatar\":\"eb32f76a4d1ca6ec80fa329bf17c8fab\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"TMD\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":574},{\"type\":0,\"content\":\"- Tifa slap fight > Highwind deck, there should be at least 1 text box here for mashing/turbo muscle memory\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T15:27:31.419000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304104959398379550\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":573},{\"type\":0,\"content\":\"Disc 1 feedback - Some of this stands out more to me than others, I think some of it is more personal preference though and maybe not worth changing\\n\\n\\u2022Top of wall market first visit, atleast 1 text box?\\n\\u2022Speed up handing over the energy drink in wall market\\n\\u2022After you see the highwind for the first time and you see the leader I personally look for a Cloud shrug as a visual cue to buffer my inputs\\n\\u2022You gain control immediately after putting Cait in the party for the first time, I normally use that paralysis to buffer movement\\n\\u2022Esther comes out immediately with a text box after the jockeys. Wasn't used to it but maybe not necessary to change\\n\\u2022On the Gold Saucer revisit I personally use Cid putting his arm out as visual cue to anticipate for the dialogue choice rather than Barret\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T14:26:24.229000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304089578088562719\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":572},{\"type\":19,\"content\":\"I'm not sure if you got this sorted yet but incase you haven't - you should only need to change the gameMoment read value from short to ushort\\nAnd make sure that livesplit is comparing against game time and not real time\",\"mentions\":[{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[{\"id\":\"1304022863472234568\",\"filename\":\"image.png\",\"size\":4372,\"url\":\"https://cdn.discordapp.com/attachments/1288235003901120586/1304022863472234568/image.png?ex=6a6e6cae&is=6a6d1b2e&hm=08aff62105de5d8525849b16eeb8f991393e860ca6f03ca9a5d7fd66125fe181&\",\"proxy_url\":\"https://media.discordapp.net/attachments/1288235003901120586/1304022863472234568/image.png?ex=6a6e6cae&is=6a6d1b2e&hm=08aff62105de5d8525849b16eeb8f991393e860ca6f03ca9a5d7fd66125fe181&\",\"width\":617,\"height\":24,\"content_type\":\"image/png\",\"content_scan_version\":4,\"placeholder\":\"yfcBAYBC2VaUiQWL9mqpv2Y=\",\"placeholder_version\":1},{\"id\":\"1304022863774486559\",\"filename\":\"image.png\",\"size\":11653,\"url\":\"https://cdn.discordapp.com/attachments/1288235003901120586/1304022863774486559/image.png?ex=6a6e6cae&is=6a6d1b2e&hm=2ef42a0da34afdf40a7994202eb50d8305bc7513ee24c9f81702989400fc7818&\",\"proxy_url\":\"https://media.discordapp.net/attachments/1288235003901120586/1304022863774486559/image.png?ex=6a6e6cae&is=6a6d1b2e&hm=2ef42a0da34afdf40a7994202eb50d8305bc7513ee24c9f81702989400fc7818&\",\"width\":403,\"height\":193,\"content_type\":\"image/png\",\"content_scan_version\":4,\"placeholder\":\"6/cNA4AfFTlblwebqgGFOVA=\",\"placeholder_version\":1}],\"embeds\":[],\"timestamp\":\"2024-11-07T10:01:18.283000+00:00\",\"edited_timestamp\":\"2024-11-07T10:04:12.142000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304022863715500083\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"521419888959684659\",\"username\":\"themattdavis\",\"avatar\":\"eb32f76a4d1ca6ec80fa329bf17c8fab\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"TMD\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"message_reference\":{\"type\":0,\"channel_id\":\"1288235003901120586\",\"message_id\":\"1303886070278131712\",\"guild_id\":\"936291902133796955\"},\"position\":571,\"referenced_message\":{\"type\":0,\"content\":\"We also edited TMDs one but the break isn't working yet either\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T00:57:44.186000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1303886070278131712\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":525}},{\"type\":0,\"content\":\"\\ud83c\\udfaf We're on the final push to finish Disc 1.\\n\\nCan you all send me your suggestions to further trim Disc 1? Don't worry if it's already been sent or in this thread, I'm finding it difficult to gather it all up into a single list I can chip away at. \\n\\nI'd really appreciate it if you could test the latest version v0.4.8 on Emu or Disc to check for minor issues.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T09:58:00.202000+00:00\",\"edited_timestamp\":\"2024-11-07T13:54:17.604000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304022032903835658\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":570},{\"type\":0,\"content\":\"\\ud83c\\udfae Release v0.4.8 https://github.com/individualcontributordev/Final-Fantasy-7-CSR/tree/main/v0.4.8\\n\\n- Fixed error in Emu console which may be causing the Disc 2 loading issues after the Break Scene, testing on PSX disc needed to verify\\n- Restored scene where Cloud is carrying Aeris in the water (Aeris dying is a big deal so an extra ~10 seconds of a cutscene is worth it I think)\\n- Trimmed Rocket town first visit a bit more\\n- Fixed \\\"Shake it\\\" scene after Red Dragon\\n- Trimmed Gold Saucer date scenes and hotel lobby a bit more\\n- Fixed Junon down right scene missing and restored the command game tutorial section with text box queues (this whole section felt a bit weird after trimming so I started again and trimmed a tiny bit, can be reviewed)\\n\\nNo Disc 2 changes in this release\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[{\"type\":\"article\",\"url\":\"https://github.com/individualcontributordev/Final-Fantasy-7-CSR/tree/main/v0.4.8\",\"title\":\"Final-Fantasy-7-CSR/v0.4.8 at main \\u00b7 individualcontributordev/Final...\",\"description\":\"Final Fantasy 7 CutScenes Removed. Contribute to individualcontributordev/Final-Fantasy-7-CSR development by creating an account on GitHub.\",\"color\":1975079,\"provider\":{\"name\":\"GitHub\"},\"thumbnail\":{\"url\":\"https://opengraph.githubassets.com/0467369a16c89150e18ba50245963e887e779ca8c682fcee9ce72fe4f74d4698/individualcontributordev/Final-Fantasy-7-CSR\",\"proxy_url\":\"https://images-ext-1.discordapp.net/external/ICDHH1Vho5ysSxdq9HtPP77GNWQGK95e5ZrDyP9nDIY/https/opengraph.githubassets.com/0467369a16c89150e18ba50245963e887e779ca8c682fcee9ce72fe4f74d4698/individualcontributordev/Final-Fantasy-7-CSR\",\"width\":1200,\"height\":600,\"content_type\":\"image/png\",\"placeholder\":\"/fcFBIBri8WTl2hceV+zHT/L8Q==\",\"placeholder_version\":1,\"flags\":0},\"content_scan_version\":3}],\"timestamp\":\"2024-11-07T09:21:16.982000+00:00\",\"edited_timestamp\":\"2024-11-07T13:08:39.391000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304012791929372676\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":569},{\"type\":0,\"content\":\"Thanks man! I'll have any feedback for you\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T01:15:43.460000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1303890597081514085\",\"channel_id\":\"