sition\":1280},{\"type\":0,\"content\":\"Yeah it's minor, but it's just a consideration.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-16T23:04:12.177000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1307481377297662033\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1279},{\"type\":0,\"content\":\"What is the alternative I wonder? I'll be reviewing Corn's run tomorrow for NMS and can have a look, but will revert until we know more.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-16T23:03:39.704000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1307481241096028233\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1278},{\"type\":0,\"content\":\"I doubt that would ever change wether you pick up yoshiyuki\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-16T22:57:59.957000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1307479816093700146\",\"ch