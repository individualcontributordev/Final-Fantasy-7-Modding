            "text": "[{\"type\":0,\"content\":\"Everyone wanted to see a Sephiroth Elevator fight\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-28T00:18:02.200000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1300252200848593018\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":130},{\"type\":0,\"content\":\"This is actually awesome\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-28T00:17:35.202000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1300252087610769419\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"191046608064872449\",\"username\":\"hopeproductions\",\"avatar\":\"ea6a8fcda648eb65fdae9becbd0c4fe4\",\"discriminator\":\"0\",\"public_flags\":512,\"flags\":512,\"banner\":null,\"accent_color\":null,\"global_name\":\"Hope\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":129},{\"type\":0,\"content\":\"lol\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[{\"id\":\"1300250631285768222\",\"filename\":\"image.png\",\"size\":555464,\"url\":\"https://cdn.discordapp.com/attachments/1288235003901120586/1300250631285768222/image.png?ex=6a6e8b43&is=6a6d39c3&hm=cacee9fe02b07fc9e3a65437c2f39a1d0e1015b4b29ff5aa77513c3be0247454&\",\"proxy_url\":\"https://media.discordapp.net/attachments/128823500390