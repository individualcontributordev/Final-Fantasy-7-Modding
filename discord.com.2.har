            "text": "[{\"type\":0,\"content\":\"The very first one softlocked in Don Corneo's basement, 0.4.6 and 0.4.9 both didn't let me through after letting the break timer run out\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:50:55.121000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304609130266234890\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":800},{\"type\":0,\"content\":\"did they work to disc swap?\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:50:12.016000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304608949470892132\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":799},{\"type\":0,\"content\":\"I've burned 0.4.6, 0.4.9, and the very first one\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:49:55.164000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304608878788476928\",\"channel_id\":\"1288235003901120586\",\"author\":{\"