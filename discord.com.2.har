0,\"content_type\":\"image/jpeg\",\"placeholder\":\"BQgKBIDwwpZpaXl3iHjQSwO9NQ==\",\"placeholder_version\":1,\"flags\":0},\"video\":{\"url\":\"https://player.twitch.tv/?video=2279033573&player=twitter&autoplay=true&parent=meta.tag\",\"width\":640,\"height\":378,\"content_type\":\"text/html\",\"flags\":0},\"content_scan_version\":4}],\"timestamp\":\"2024-11-17T17:21:00.418000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1307757397065863248\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1317},{\"type\":0,\"content\":\"I know off the top of my head, you recieve an item at the end of Disc 2 in FF9 completely out of context of the scene its in. I'll grab a clip\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-17T17:19:52.082000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1307757110444163072\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1316},{\"type\":0,\"content\":\"As for the 1500 gil pop up appearing on its own, it's been used in the other 2 CSRs. Again, they're not the gospel to follow either but it does work for them\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-17T17:18:56.182000+00:00\",\"edited_timestamp\":\"2024-11-17T17:19:09.267000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1307756875982311537\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1315},{\"type\":0,\"content\":\"Honest opinion is that I think the Reno scene looks worse now sped up, I think it would just be neater if it was cut. Again, you're the creator so up to you but I think it makes it look 'janky' in that current state\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-17T17:18:18.900000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1307756719610269767\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1314},{\"type\":0,\"content\":\"Barret throwing Gil scene trimmed down to only 10 seconds. I prefer this over completely cutting the scene and showing a text box with \\\"1500 gil\\\" randomly.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[{\"id\":\"1307755920192700557\",\"filename\":\"2024-11-17_17-08-40_-_Trim.mp4\",\"size\":2591930,\"url\":\"https://cdn.discordapp.com/attachments/1288235003901120586/1307755920192700557/2024-11-17_17-08-40_-_Trim.mp4?ex=6a6e299c&is=6a6cd81c&hm=5a65760a91709e4be5d81dbf3fe5e1d58fd1cef8419932f13fcb1064e1fc8e1e&\",\"proxy_url\":\"https://media.discordapp.net/attachments/1288235003901120586/1307755920192700557/2024-11-17_17-08-40_-_Trim.mp4?ex=6a6e299c&is=6a6cd81c&hm=5a65760a91709e4be5d81dbf3fe5e1d58fd1cef8419932f13fcb1064e1fc8e1e&\",\"width\":1280,\"height\":720,\"content_type\":\"video/mp4\",\"content_scan_version\":3,\"placeholder\":\"xQcKBICQa6d6iHeJeHpfL1jQFg==\",\"placeholder_version\":1,\"title\":\"2024-11-17 17-08-40 - Trim\"}],\"embeds\":[],\"timestamp\":\"2024-11-17T17:15:08.375000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1307755920490627104\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1313},{\"type\":0,\"content\":\"Sped up Reno fight, 8 seconds from fade in to fight, I feel better about this than completely removing the scene and not seeing Reno before the fight.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-17T17:01:38.609000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1307752524085854279\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1312},{\"type\":0,\"content\":\"\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[{\"id\":\"1307752255419584632\",\"filename\":\"2024-11-17_17-00-02.mp4\",\"size\":5131580,\"url\":\"https://cdn.discordapp.com/attachments/1288235003901120586/1307752255419584632/2024-11-17_17-00-02.mp4?ex=6a6e2632&is=6a6cd4b2&hm=bc1b2c26ba89fcb20a074715d890fe61c5567ebc072874e201b804095d206f06&\",\"proxy_url\":\"https://media.discordapp.net/attachments/1288235003901120586/1307752255419584632/2024-11-17_17-00-02.mp4?ex=6a6e2632&is=6a6cd4b2&hm=bc1b2c26ba89fcb20a074715d890fe61c5567ebc072874e201b804095d206f06&\",\"width\":1280,\"height\":720,\"content_type\":\"video/mp4\",\"placeholder\":\"C/gFBIA5dRNJqlYgzH1fVgNypg==\",\"placeholder_version\":1,\"title\":\"2024-11-17 17-00-02\"}],\"embeds\":[],\"timestamp\":\"2024-11-17T17:00:34.659000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1307752255860244570\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1311},{\"type\":0,\"content\":\"Thanks Phek, I've only covered the Cait route so far so I'll check that for the next patch.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-17T10:38:58.241000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1307656221322514554\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1310,\"reactions\":[{\"emoji\":{\"id\":null,\"name\":\"\\ud83d\\udc4d\"},\"count\":1,\"count_details\":{\"burst\":0,\"normal\":1},\"burst_colors\":[],\"me_burst\":false,\"burst_me\":false,\"me\":false,\"burst_count\":0}]},{\"type\":0,\"content\":\"One big difference is after RD fight, with Cait in party he will jump over to Cloud and said let him handle the Black Materia, but with Tifa in party then Cloud gets a phonecall from Cait instead\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-17T03:51:33.009000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1307553690588287037\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"385844703091884033\",\"username\":\"phek1200\",\"avatar\":\"defa3ccf4c743532ee4492eeeabde14c\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"phek1200\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1309},{\"type\":0,\"content\":\"NMS uses Tifa in temple, so it's worth looking at her dialogues and cut out some of it (if the current one focuses on cutting out Cait's). This will be applicable to no slots runner using Tifa temple as well, such as myself.\\nEdit: Hundo, All Bosses uses Tifa temple as well so definitely worth doing this\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-17T03:50:24.304000+00:00\",\"edited_timestamp\":\"2024-11-17T11:21:59.128000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1307553402418364489\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"385844703091884033\",\"username\":\"phek1200\",\"avatar\":\"defa3ccf4c743532ee4492eeeabde14c\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"phek1200\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1308},{\"type\":0,\"content\":\"Cool let's do it for Reno. Bottomswell I like at the moment but we can always revisit later.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-16T23:30:02.314000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1307487879043481741\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1307,\"reactions\":[{\"emoji\":{\"id\":null,\"name\":\"\\ud83d\\udc4c\"},\"count\":1,\"count_details\":{\"burst\":0,\"normal\":1},\"burst_colors\":[],\"me_burst\":false,\"burst_me\":false,\"me\":false,\"burst_count\":0}]}]\n"
